<?xml version="1.0"?>
<addon scheme="3.0">
    <id>customizable_homepage_popup</id>
    <version>1.0.0</version>
    <priority>1000</priority>
    <position>100</position>
    <status>disabled</status>
    <default_language>EN</default_language>
    <name language_variable="customizable_homepage_popup.addon_name">Customizable Homepage Popup</name>
    <description language_variable="customizable_homepage_popup.addon_description">Displays a configurable popup on the homepage.</description>
    <authors>
        <author>
            <name>Your Name/Company</name>
            <email>your.email@example.com</email>
            <url>http://example.com</url>
        </author>
    </authors>
    <compatibility>
        <core_version min="4.0.0" />
        <core_edition>ULTIMATE,MULTIVENDOR</core_edition>
    </compatibility>
    <settings layout="separate">
        <sections>
            <section id="general">
                <name language_variable="customizable_homepage_popup.settings.general_tab">General</name>
            </section>
        </sections>
    </settings>
</addon>
